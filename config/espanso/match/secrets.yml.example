# Example private match definitions
# Copy this file to secrets.yml and add your private details.
# secrets.yml is ignored by git so your private information will never be committed.

matches:
  # Phone numbers:
  # Use :+ or :i for international (+20...), and plain : for bare (no country code, no leading 0)
  - triggers: [":+phone", ":iphone"]
    replace: "+201123456789"

  - trigger: ":phone"
    replace: "1123456789"

  # Personal address
  - trigger: ":addr"
    replace: |
      123 Main Street, Apt 4B
      City, Country

  # Postal code
  - trigger: ":zip"
    replace: "12345"
