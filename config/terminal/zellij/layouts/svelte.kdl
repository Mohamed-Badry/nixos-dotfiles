layout {
    default_tab_template {
        children
        pane size=1 borderless=true {
            plugin location="file:~/.config/zellij/plugins/zjstatus.wasm" {
                format_left   "{mode}#[bg=#26233a,fg=#e0def4,bold] 󰆍 {session} #[bg=#191724,fg=#26233a]"
                format_center "{tabs}"
                format_right  "{command_jj}#[fg=#26233a,bg=#191724]#[bg=#26233a,fg=#e0def4,bold] 󰌌 F2 "
                format_space  ""
                format_hide_on_overlength "true"
                format_precedence "lcr"

                border_enabled  "false"

                mode_normal        "#[bg=#31748f,fg=#191724,bold] NORMAL #[bg=#26233a,fg=#31748f]"
                mode_locked        "#[bg=#eb6f92,fg=#191724,bold] LOCKED #[bg=#26233a,fg=#eb6f92]"
                mode_resize        "#[bg=#f6c177,fg=#191724,bold] RESIZE #[bg=#26233a,fg=#f6c177]"
                mode_pane          "#[bg=#9ccfd8,fg=#191724,bold] PANE #[bg=#26233a,fg=#9ccfd8]"
                mode_tab           "#[bg=#c4a7e7,fg=#191724,bold] TAB #[bg=#26233a,fg=#c4a7e7]"
                mode_scroll        "#[bg=#f6c177,fg=#191724,bold] SCROLL #[bg=#26233a,fg=#f6c177]"
                mode_session       "#[bg=#ebbcba,fg=#191724,bold] SESSION #[bg=#26233a,fg=#ebbcba]"
                mode_move          "#[bg=#9ccfd8,fg=#191724,bold] MOVE #[bg=#26233a,fg=#9ccfd8]"
                mode_search        "#[bg=#f6c177,fg=#191724,bold] SEARCH #[bg=#26233a,fg=#f6c177]"
                mode_tmux          "#[bg=#ebbcba,fg=#191724,bold] TMUX #[bg=#26233a,fg=#ebbcba]"

                tab_normal              "#[fg=#6e6a86]○ {index}: {name} "
                tab_normal_fullscreen   "#[fg=#6e6a86]○ {index}: {name} [] "
                tab_normal_sync         "#[fg=#6e6a86]○ {index}: {name} <> "
                tab_active              "#[fg=#9ccfd8,bold]● {index}: {name} "
                tab_active_fullscreen   "#[fg=#9ccfd8,bold]● {index}: {name} [] "
                tab_active_sync         "#[fg=#9ccfd8,bold]● {index}: {name} <> "
                tab_separator           " "

                command_jj_command     "/home/crim/dotfiles/config/terminal/zellij/scripts/jj-status.sh"
                command_jj_format      "#[fg=#31748f,bg=#191724]#[bg=#31748f,fg=#191724,bold]  {stdout} #[fg=#191724,bg=#31748f]"
                command_jj_interval    "2"
                command_jj_rendermode  "static"
                command_jj_hideonemptystdout "true"
            }
        }
    }

    // Tab 1: Main
    tab name="Main" focus=true {
        pane split_direction="horizontal" {
            pane name="Main" size="50%"
            pane name="Other" size="50%"
        }
    }

    // Tab 2: Editor (Svelte + Bun)
    tab name="Editor" {
        pane split_direction="vertical" {
            // Left: Helix
            pane command="fish" name="Helix" size="70%" {
                args "-c" "hx .; exec fish"
            }

            // Right: The Bun Stack
            pane split_direction="horizontal" {
                // Top Right: The Dev Server
                pane command="fish" name="Server" {
                    args "-c" "bun run dev -- --open; exec fish"
                }
                
                // Bottom Right: Quick Terminal
                pane name="Shell"
            }
        }
    }

    // Tab 3: Agents
    tab name="Agents" {
        pane split_direction="horizontal" {
            pane name="Gemini"
            pane name="Codex" size="50%"
        }
    }
}
