binds {
    Mod+Question { spawn "noctalia" "msg" "panel-toggle" "kenn/keybind-cheatsheet:cheatsheet"; }
    Mod+Slash { spawn "noctalia" "msg" "panel-toggle" "kenn/keybind-cheatsheet:cheatsheet"; }
    Mod+Shift+Slash { spawn "noctalia" "msg" "panel-toggle" "kenn/keybind-cheatsheet:cheatsheet"; }
    Mod+Return { spawn "wezterm"; }
    Mod+T { spawn "wezterm"; }
    Mod+A { spawn "noctalia" "msg" "panel-toggle" "launcher"; }
    Mod+D { spawn "noctalia" "msg" "panel-toggle" "wallpaper"; }
    Mod+Shift+D { spawn "noctalia" "msg" "panel-toggle" "noctalia/wallhaven:browser"; }
    Mod+W { toggle-overview; }
    Mod+B { spawn "zen"; }
    Mod+Ctrl+B { spawn "launch-zen-vesktop"; }
    Mod+Q { close-window; }
    Mod+Shift+E { quit; }
    Mod+Escape { spawn "qylock-lock"; }
    Mod+Backspace { spawn "noctalia" "msg" "panel-toggle" "session"; }
    Mod+E { spawn "env" "QT_QPA_PLATFORMTHEME=qt6ct" "pcmanfm-qt"; }
    Mod+I { spawn "noctalia" "msg" "settings-toggle"; }

    Mod+H { focus-column-left; }
    Mod+L { focus-column-right; }
    Mod+J { focus-window-or-workspace-down; }
    Mod+K { focus-window-or-workspace-up; }
    Mod+Left { focus-column-left; }
    Mod+Right { focus-column-right; }
    Mod+Down { focus-window-or-workspace-down; }
    Mod+Up { focus-window-or-workspace-up; }

    Mod+Shift+H { move-column-left; }
    Mod+Shift+L { move-column-right; }
    Mod+Shift+J { move-window-to-workspace-down; }
    Mod+Shift+K { move-window-to-workspace-up; }
    Mod+Shift+Left { move-column-left; }
    Mod+Shift+Right { move-column-right; }
    Mod+Shift+Down { move-window-to-workspace-down; }
    Mod+Shift+Up { move-window-to-workspace-up; }

    Mod+Alt+J { move-window-down; }
    Mod+Alt+K { move-window-up; }
    Mod+Alt+Down { move-window-down; }
    Mod+Alt+Up { move-window-up; }

    Mod+Alt+H { consume-or-expel-window-left; }
    Mod+Alt+L { consume-or-expel-window-right; }
    Mod+Alt+Left { consume-or-expel-window-left; }
    Mod+Alt+Right { consume-or-expel-window-right; }

    Mod+Ctrl+J { focus-workspace-down; }
    Mod+Ctrl+K { focus-workspace-up; }
    Mod+Ctrl+Down { focus-workspace-down; }
    Mod+Ctrl+Up { focus-workspace-up; }
    Mod+Ctrl+Shift+J { spawn "niri" "msg" "action" "move-window-to-workspace-down" "--focus" "false"; }
    Mod+Ctrl+Shift+K { spawn "niri" "msg" "action" "move-window-to-workspace-up" "--focus" "false"; }
    Mod+Ctrl+Shift+Down { spawn "niri" "msg" "action" "move-window-to-workspace-down" "--focus" "false"; }
    Mod+Ctrl+Shift+Up { spawn "niri" "msg" "action" "move-window-to-workspace-up" "--focus" "false"; }

    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }
    Mod+Shift+1 { move-column-to-workspace 1; }
    Mod+Shift+2 { move-column-to-workspace 2; }
    Mod+Shift+3 { move-column-to-workspace 3; }
    Mod+Shift+4 { move-column-to-workspace 4; }
    Mod+Shift+5 { move-column-to-workspace 5; }
    Mod+Shift+6 { move-column-to-workspace 6; }
    Mod+Shift+7 { move-column-to-workspace 7; }
    Mod+Shift+8 { move-column-to-workspace 8; }
    Mod+Shift+9 { move-column-to-workspace 9; }

    Mod+R { switch-preset-column-width; }
    Mod+Minus { set-column-width "-10%"; }
    Mod+Equal { set-column-width "+10%"; }
    Mod+F { spawn "sh" "-c" "if niri msg -j windows | jq -e '.[] | select(.is_focused) | .is_floating' >/dev/null; then niri msg action toggle-window-floating; fi; niri msg action maximize-column"; }
    Mod+M { maximize-window-to-edges; }
    Mod+F11 { fullscreen-window; }
    Mod+Shift+R { switch-preset-column-width-back; }
    Mod+Y { toggle-window-floating; }
    Mod+Shift+Y { switch-focus-between-floating-and-tiling; }
    Mod+P { spawn "niri-float-sticky" "toggle"; }

    Mod+V { spawn "noctalia" "msg" "panel-toggle" "clipboard"; }
    Mod+Space { switch-layout "next"; }
    Mod+Shift+C { spawn "hyprpicker" "-a"; }
    Mod+Grave { spawn "toggle-scratchpad"; }
    Print { screenshot; }
    Alt+Print { screenshot-window; }
    Ctrl+Print { spawn "sh" "-c" "grim -g \"$(slurp)\" - | wl-copy"; }
    Mod+Shift+Print { spawn "sh" "-c" "grim -g \"$(slurp)\" - | satty --filename -"; }
    Mod+Ctrl+Print { spawn "obs-toggle-record"; }

    Mod+Z { spawn "smart-playerctl" "previous"; }
    Mod+X { spawn "smart-playerctl" "play-pause"; }
    Mod+C { spawn "smart-playerctl" "next"; }
    Mod+Shift+X { spawn "smart-playerctl" "cycle"; }

    XF86AudioRaiseVolume { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "5%+"; }
    XF86AudioLowerVolume { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "5%-"; }
    XF86AudioMute { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SINK@" "toggle"; }
    XF86AudioMicMute { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SOURCE@" "toggle"; }
    XF86MonBrightnessUp { spawn "brightnessctl" "set" "10%+"; }
    XF86MonBrightnessDown { spawn "brightnessctl" "set" "10%-"; }
    XF86Launch4 { spawn "asus-profile-switch"; }
    Mod+F5 { spawn "asus-profile-switch"; }
    XF86KbdBrightnessDown { spawn "asus-aura-mode" "prev"; }
    XF86KbdBrightnessUp { spawn "asus-aura-mode" "next"; }
}
