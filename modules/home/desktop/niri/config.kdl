include "theme.kdl"
include "noctalia.kdl"
include "binds.kdl"
include "scroll-mode.kdl"

input {
    keyboard {
        xkb {
            layout "us,ara"
        }
    }
    touchpad {
        tap
        natural-scroll
    }
}

layout {
    gaps 12
    background-color "transparent"
    default-column-width {
        proportion 0.5
    }
    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
        proportion 0.967
    }
}

workspace "mail"
workspace "web"
workspace "comms"

prefer-no-csd
screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

spawn-at-startup "dbus-update-activation-environment" "--systemd" "WAYLAND_DISPLAY" "XDG_RUNTIME_DIR" "DISPLAY" "SSH_AUTH_SOCK" "GNOME_KEYRING_CONTROL"
spawn-at-startup "gnome-keyring-daemon" "--start" "--components=secrets"
spawn-at-startup "noctalia"
spawn-at-startup "niri-float-sticky"
spawn-at-startup "thunar" "--daemon"
spawn-at-startup "vesktop" "--start-minimized"

layer-rule {
    match namespace="^noctalia-wallpaper.*$"
    place-within-backdrop true
}

window-rule {
    match app-id="scratchpad"
    open-floating true
    default-column-width {
        fixed 1000
    }
    default-window-height {
        fixed 650
    }
}

window-rule {
    match app-id="xdg-desktop-portal-gnome"
    match app-id="org.gnome.Portal"
    match app-id="xdg-desktop-portal-gtk"
    open-floating true
}

window-rule {
    match app-id="(?i)^thunar$"
    geometry-corner-radius 12
    clip-to-geometry true
    opacity 0.92
    background-effect {
        blur true
    }
}

window-rule {
    match app-id="(?i)^thunar$" title="^File Operation Progress$"
    match app-id="(?i)^thunar$" title="^Confirm to replace files$"
    match app-id="(?i)^thunar$" title=".*Preferences$"
    match app-id="(?i)^thunar$" title=".*Properties$"
    open-floating true
}

window-rule {
    match app-id="zapfast"
    match app-id="vesktop"
    open-on-workspace "comms"
    default-column-width {
        proportion 0.967
    }
}

window-rule {
    match app-id="zen"
    open-on-workspace "web"
    default-column-width {
        proportion 0.967
    }
}

window-rule {
    match app-id="(?i)mailspring"
    open-on-workspace "mail"
    default-column-width {
        proportion 0.967
    }
}

